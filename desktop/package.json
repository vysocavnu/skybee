{
  "name": "skybee",
  "productName": "Skybee",
  "version": "0.2.0",
  "description": "Skybee — відкритий клієнт для Bluesky",
  "author": "vysocavnu",
  "license": "MIT",
  "homepage": "https://vysocavnu.github.io/skybee",
  "private": true,
  "main": "main.js",
  "scripts": {
    "web": "node ../scripts/dist.mjs",
    "start": "npm run web && electron .",
    "dist": "npm run web && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.vysocavnu.skybee",
    "productName": "Skybee",
    "files": [
      "main.js",
      "icon.png",
      "web/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "Skybee-${version}-setup.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "uk_UA",
        "en_US"
      ],
      "license": "../LICENSE",
      "shortcutName": "Skybee",
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vysocavnu",
        "repo": "skybee",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
