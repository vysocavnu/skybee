{
  "name": "skybee",
  "productName": "Skybee",
  "version": "0.3.1",
  "description": "Skybee — відкритий клієнт для Bluesky",
  "author": {
    "name": "vysocavnu",
    "email": "vysocavnu@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://vysocavnu.github.io/skybee",
  "private": true,
  "main": "main.js",
  "scripts": {
    "web": "node ../scripts/dist.mjs",
    "start": "npm run web && electron .",
    "dist": "npm run web && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run web && electron-builder --linux --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.vysocavnu.skybee",
    "productName": "Skybee",
    "protocols": [
      {
        "name": "Skybee",
        "schemes": [
          "skybee"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "web/**"
    ],
    "directories": {
      "output": "dist"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "Skybee-${version}-setup.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "uk_UA",
        "en_US"
      ],
      "license": "../LICENSE",
      "shortcutName": "Skybee",
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vysocavnu",
        "repo": "skybee",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "Network",
      "executableName": "skybee",
      "synopsis": "Відкритий клієнт для Bluesky",
      "artifactName": "Skybee-${version}-linux-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
