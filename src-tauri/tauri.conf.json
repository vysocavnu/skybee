{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skybee",
  "version": "0.1.0",
  "identifier": "io.github.vysocavnu.skybee",
  "build": {
    "beforeBuildCommand": "node scripts/dist.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "vysocavnu",
    "homepage": "https://vysocavnu.github.io/skybee",
    "shortDescription": "Клієнт Bluesky",
    "longDescription": "Skybee — відкритий клієнт для Bluesky (AT Protocol).",
    "category": "SocialNetworking",
    "licenseFile": "../LICENSE",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Ukrainian", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
